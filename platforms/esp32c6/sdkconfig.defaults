# Overrides applied over defconfig
# Additional changes can be made via ESP_IDF_SDKCONFIG_OPTS
# NB: written against ESP-IDF v6.x Kconfig names; run a build and check for
# "unknown kconfig symbol" warnings after any IDF upgrade.

CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../esp32xx/partitions_mgos.csv"
CONFIG_PARTITION_TABLE_FILENAME="../esp32xx/partitions_mgos.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=n
CONFIG_ESP_COREDUMP_ENABLE=y
CONFIG_ESP_COREDUMP_UART_DELAY=0
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_PANIC=y

CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=n
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=2
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# Most C6 boards ship with DIO flash; QIO can be enabled per-board.
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Required to be able to update boot loader.
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y

# HW timer HAL (gptimer) starts/stops timers from ISR context.
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y



# App-specific settings below.

# WPA-enterprise off: mgos whole-archive linking of the IDF 6
# wpa_supplicant collides on duplicate eap_fast symbols. Re-enable and
# fix linking if enterprise is needed.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# TLS (mongoose mg_ssl_if_mbedtls on mbedTLS 4):
# - FS_IO: mgos loads certs from the VFS (mbedtls_x509_crt_parse_file);
# - KEEP_PEER_CERTIFICATE=n: replaces the MG_SSL_IF_MBEDTLS_FREE_CERTS
#   post-handshake cert freeing, whose fields are private in >= 3.x.
CONFIG_MBEDTLS_FS_IO=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
# mgos_sys_config.c calls mbedtls_debug_set_threshold (debug.mbedtls_level);
# only compiled with MBEDTLS_DEBUG_C. Also handy for TLS bring-up.
CONFIG_MBEDTLS_DEBUG=y
